{
  "name": "voicex",
  "version": "0.19.3",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-server.mjs",
    "build": "node scripts/check-i18n.mjs && vue-tsc --noEmit && vite build",
    "test": "node scripts/check-frontend.mjs",
    "test:i18n": "node scripts/check-i18n.mjs",
    "test:defaults": "node scripts/check-frontend.mjs src/stores/settings.spec.ts src/stores/llmModels.spec.ts src/utils/asrDictionary.spec.ts src/utils/asrModels.spec.ts src/utils/sonioxSettings.spec.ts",
    "test:history": "node scripts/check-frontend.mjs src/stores/history.spec.ts src/utils/historySearch.spec.ts src/utils/historyPlayback.spec.ts src/utils/activityGrid.spec.ts src/stores/appIcons.spec.ts",
    "test:diff": "node scripts/check-frontend.mjs src/utils/textDiff.spec.ts",
    "check:rust": "cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib --bins",
    "check": "pnpm build && pnpm test --skip-i18n && pnpm check:rust && pnpm test:rust",
    "preview": "vite preview",
    "tauri": "node scripts/tauri.mjs",
    "mac:setup-signing": "bash ./scripts/setup-macos-local-signing.sh",
    "mac:build-local": "bash ./scripts/build-macos-local-release.sh",
    "mac:release": "bash ./scripts/release-macos.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "markdown-it": "^15.0.3",
    "pinia": "^3.0.0",
    "vue": "^3.5.13",
    "vue-i18n": "^10.0.5",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/markdown-it": "^14.2.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "naive-ui": "^2.42.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vue-tsc": "^2.1.10"
  }
}
